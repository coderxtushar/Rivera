# ─── Copy to .env and fill in. Only MONGODB_URI is required for local dev. ───

NODE_ENV=development
PORT=4000
# LOG_LEVEL=debug

# MongoDB — local Docker (docker compose up mongo) or a free Atlas M0 cluster.
MONGODB_URI=mongodb://localhost:27017/rivera

# Secrets — REQUIRED in production, at least 32 chars each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Frontend URL (used in email links) and allowed CORS origins (comma-separated).
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Cookies. Frontend and API on different sites (e.g. vercel.app + onrender.com)?
# Then use COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=

# Number of proxies in front of the app (1 for Render/Railway/Fly).
TRUST_PROXY=1

# Rate limiting (per IP, per window).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Marketplace rules
INSTRUCTOR_AUTO_APPROVE=true
REQUIRE_EMAIL_VERIFICATION=false
PLATFORM_FEE_PERCENT=20
DEFAULT_CURRENCY=INR

# Payments: mock | razorpay | stripe   (mock is refused in production unless ALLOW_MOCK_PAYMENTS=true)
PAYMENT_PROVIDER=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Email (optional). Without SMTP, emails are printed to the log.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=Rivera <no-reply@example.com>

# Media uploads via Cloudinary (optional, free tier).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Used by `npm run seed` to create the first admin account.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
